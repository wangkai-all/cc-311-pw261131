{
  "name": "gridtrace-dr-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Synthetic demand-response attribution workbench with auditable baselines",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "dev": "tsx watch src/server.ts",
    "gen:demo": "tsx scripts/generate-demo.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
